<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Logistics &#38; Shipment Management" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Shipper" name="Shipper / Customer">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Book</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dispatcher" name="Control Tower / Dispatcher">
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Tracking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Delivered</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pickup" name="Pickup Agent">
        <bpmn:flowNodeRef>Task_Collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Split</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Hub" name="Hub / Warehouse">
        <bpmn:flowNodeRef>Task_Sort</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Damaged</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Delivery" name="Delivery Agent">
        <bpmn:flowNodeRef>Task_NotifyRecipient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Returned</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Recipient" name="Recipient">
        <bpmn:flowNodeRef>Task_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Accepted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Claims" name="Claims Department">
        <bpmn:flowNodeRef>Task_Claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Claim</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="Shipper books shipment">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_Book" name="Create shipment booking">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F_Invalid</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:businessRuleTask id="Task_Validate" name="Validate booking and calculate charges">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="GW_Valid" name="Valid?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F_Valid</bpmn:outgoing>
      <bpmn:outgoing>F_Invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Schedule" name="Schedule pickup and assign agent">
      <bpmn:incoming>F_Valid</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_Collect" name="Collect and scan parcel">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="GW_Split">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sendTask id="Task_Tracking" name="Update tracking and notify shipper">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:userTask id="Task_Sort" name="Sort and move parcel to destination hub">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="GW_Join">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="Task_Inspect" name="Inspect parcel">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="GW_Damaged" name="Damaged?">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F_Damaged</bpmn:outgoing>
      <bpmn:outgoing>F_Ok</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_Claim" name="Settle claim (refund or replacement)">
      <bpmn:incoming>F_Damaged</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_Claim" name="Closed: claim settled">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sendTask id="Task_NotifyRecipient" name="Notify recipient (out for delivery)">
      <bpmn:incoming>F_Ok</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:userTask id="Task_Deliver" name="Deliver parcel">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Accept" name="Accept or refuse parcel">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="GW_Accepted" name="Accepted?">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F_Accepted</bpmn:outgoing>
      <bpmn:outgoing>F_Refused</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Close" name="Record proof of delivery, close shipment and invoice">
      <bpmn:incoming>F_Accepted</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Delivered" name="Shipment delivered">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_Return" name="Return parcel to sender">
      <bpmn:incoming>F_Refused</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_Returned" name="Returned to sender">
      <bpmn:incoming>F17</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Book" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Book" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Validate" targetRef="GW_Valid" />
    <bpmn:sequenceFlow id="F_Valid" name="Yes" sourceRef="GW_Valid" targetRef="Task_Schedule" />
    <bpmn:sequenceFlow id="F_Invalid" name="No (correct booking)" sourceRef="GW_Valid" targetRef="Task_Book" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Schedule" targetRef="Task_Collect" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Collect" targetRef="GW_Split" />
    <bpmn:sequenceFlow id="F6" sourceRef="GW_Split" targetRef="Task_Tracking" />
    <bpmn:sequenceFlow id="F7" sourceRef="GW_Split" targetRef="Task_Sort" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Tracking" targetRef="GW_Join" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Sort" targetRef="GW_Join" />
    <bpmn:sequenceFlow id="F10" sourceRef="GW_Join" targetRef="Task_Inspect" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Inspect" targetRef="GW_Damaged" />
    <bpmn:sequenceFlow id="F_Damaged" name="Yes" sourceRef="GW_Damaged" targetRef="Task_Claim" />
    <bpmn:sequenceFlow id="F_Ok" name="No" sourceRef="GW_Damaged" targetRef="Task_NotifyRecipient" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Claim" targetRef="End_Claim" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_NotifyRecipient" targetRef="Task_Deliver" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Deliver" targetRef="Task_Accept" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Accept" targetRef="GW_Accepted" />
    <bpmn:sequenceFlow id="F_Accepted" name="Yes" sourceRef="GW_Accepted" targetRef="Task_Close" />
    <bpmn:sequenceFlow id="F_Refused" name="No (refused)" sourceRef="GW_Accepted" targetRef="Task_Return" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_Close" targetRef="End_Delivered" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_Return" targetRef="End_Returned" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="160" y="40" width="2320" height="840" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Shipper_di" bpmnElement="Lane_Shipper" isHorizontal="true">
        <dc:Bounds x="190" y="40" width="2290" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Dispatcher_di" bpmnElement="Lane_Dispatcher" isHorizontal="true">
        <dc:Bounds x="190" y="160" width="2290" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Pickup_di" bpmnElement="Lane_Pickup" isHorizontal="true">
        <dc:Bounds x="190" y="280" width="2290" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Hub_di" bpmnElement="Lane_Hub" isHorizontal="true">
        <dc:Bounds x="190" y="400" width="2290" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Delivery_di" bpmnElement="Lane_Delivery" isHorizontal="true">
        <dc:Bounds x="190" y="520" width="2290" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Recipient_di" bpmnElement="Lane_Recipient" isHorizontal="true">
        <dc:Bounds x="190" y="640" width="2290" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Claims_di" bpmnElement="Lane_Claims" isHorizontal="true">
        <dc:Bounds x="190" y="760" width="2290" height="120" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="240" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="218" y="122" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Book_di" bpmnElement="Task_Book">
        <dc:Bounds x="320" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Validate_di" bpmnElement="Task_Validate">
        <dc:Bounds x="470" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Valid_di" bpmnElement="GW_Valid" isMarkerVisible="true">
        <dc:Bounds x="620" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="628" y="252" width="34" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Schedule_di" bpmnElement="Task_Schedule">
        <dc:Bounds x="720" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Collect_di" bpmnElement="Task_Collect">
        <dc:Bounds x="870" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Split_di" bpmnElement="GW_Split">
        <dc:Bounds x="1020" y="315" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Tracking_di" bpmnElement="Task_Tracking">
        <dc:Bounds x="1120" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Sort_di" bpmnElement="Task_Sort">
        <dc:Bounds x="1120" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Join_di" bpmnElement="GW_Join">
        <dc:Bounds x="1320" y="435" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Inspect_di" bpmnElement="Task_Inspect">
        <dc:Bounds x="1420" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Damaged_di" bpmnElement="GW_Damaged" isMarkerVisible="true">
        <dc:Bounds x="1570" y="435" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1572" y="405" width="46" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Claim_di" bpmnElement="Task_Claim">
        <dc:Bounds x="1545" y="780" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Claim_di" bpmnElement="End_Claim">
        <dc:Bounds x="1720" y="802" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1698" y="842" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyRecipient_di" bpmnElement="Task_NotifyRecipient">
        <dc:Bounds x="1670" y="540" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Deliver_di" bpmnElement="Task_Deliver">
        <dc:Bounds x="1820" y="540" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Accept_di" bpmnElement="Task_Accept">
        <dc:Bounds x="1820" y="660" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Accepted_di" bpmnElement="GW_Accepted" isMarkerVisible="true">
        <dc:Bounds x="1970" y="675" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1938" y="732" width="56" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Return_di" bpmnElement="Task_Return">
        <dc:Bounds x="2070" y="540" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Returned_di" bpmnElement="End_Returned">
        <dc:Bounds x="2220" y="562" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2198" y="602" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Close_di" bpmnElement="Task_Close">
        <dc:Bounds x="2250" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Delivered_di" bpmnElement="End_Delivered">
        <dc:Bounds x="2400" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2378" y="242" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="276" y="100" /><di:waypoint x="320" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="370" y="140" /><di:waypoint x="370" y="220" /><di:waypoint x="470" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="570" y="220" /><di:waypoint x="620" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Valid_di" bpmnElement="F_Valid">
        <di:waypoint x="670" y="220" /><di:waypoint x="720" y="220" />
        <bpmndi:BPMNLabel><dc:Bounds x="680" y="202" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Invalid_di" bpmnElement="F_Invalid">
        <di:waypoint x="645" y="195" /><di:waypoint x="645" y="100" /><di:waypoint x="420" y="100" />
        <bpmndi:BPMNLabel><dc:Bounds x="520" y="82" width="110" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="820" y="220" /><di:waypoint x="920" y="220" /><di:waypoint x="920" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="970" y="340" /><di:waypoint x="1020" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6">
        <di:waypoint x="1045" y="315" /><di:waypoint x="1045" y="220" /><di:waypoint x="1120" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7">
        <di:waypoint x="1045" y="365" /><di:waypoint x="1045" y="460" /><di:waypoint x="1120" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8">
        <di:waypoint x="1220" y="220" /><di:waypoint x="1345" y="220" /><di:waypoint x="1345" y="435" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9">
        <di:waypoint x="1220" y="460" /><di:waypoint x="1320" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10">
        <di:waypoint x="1370" y="460" /><di:waypoint x="1420" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11">
        <di:waypoint x="1520" y="460" /><di:waypoint x="1570" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Damaged_di" bpmnElement="F_Damaged">
        <di:waypoint x="1595" y="485" /><di:waypoint x="1595" y="780" />
        <bpmndi:BPMNLabel><dc:Bounds x="1600" y="520" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Ok_di" bpmnElement="F_Ok">
        <di:waypoint x="1620" y="460" /><di:waypoint x="1720" y="460" /><di:waypoint x="1720" y="540" />
        <bpmndi:BPMNLabel><dc:Bounds x="1630" y="442" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12">
        <di:waypoint x="1645" y="820" /><di:waypoint x="1720" y="820" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13">
        <di:waypoint x="1770" y="580" /><di:waypoint x="1820" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F14_di" bpmnElement="F14">
        <di:waypoint x="1870" y="620" /><di:waypoint x="1870" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F15_di" bpmnElement="F15">
        <di:waypoint x="1920" y="700" /><di:waypoint x="1970" y="700" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Accepted_di" bpmnElement="F_Accepted">
        <di:waypoint x="2020" y="700" /><di:waypoint x="2300" y="700" /><di:waypoint x="2300" y="260" />
        <bpmndi:BPMNLabel><dc:Bounds x="2030" y="682" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Refused_di" bpmnElement="F_Refused">
        <di:waypoint x="1995" y="675" /><di:waypoint x="1995" y="580" /><di:waypoint x="2070" y="580" />
        <bpmndi:BPMNLabel><dc:Bounds x="2000" y="640" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F16_di" bpmnElement="F16">
        <di:waypoint x="2350" y="220" /><di:waypoint x="2400" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F17_di" bpmnElement="F17">
        <di:waypoint x="2170" y="580" /><di:waypoint x="2220" y="580" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
