<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Student Project Approval &#38; Allocation" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Student" name="Student / Team">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Coordinator" name="Project Coordinator">
        <bpmn:flowNodeRef>Task_Screen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Committee" name="Review Committee (incl. HoD)">
        <bpmn:flowNodeRef>Task_Evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Decision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Guide" name="Faculty Guide">
        <bpmn:flowNodeRef>Task_GuideReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Accept</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Project Management System">
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckGuide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Allocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyStudent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Allocated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="Team decides to submit proposal">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_Submit" name="Submit proposal">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F_Invalid</bpmn:incoming>
      <bpmn:incoming>F_Revise</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_Validate" name="Validate form and team rules">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="GW_Valid" name="Valid?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F_Valid</bpmn:outgoing>
      <bpmn:outgoing>F_Invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_Screen" name="Screen proposal">
      <bpmn:incoming>F_Valid</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Evaluate" name="Evaluate proposal">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="GW_Decision" name="Decision?">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F_Approved</bpmn:outgoing>
      <bpmn:outgoing>F_Revise</bpmn:outgoing>
      <bpmn:outgoing>F_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="Task_NotifyReject" name="Notify student of rejection">
      <bpmn:incoming>F_Rejected</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="End_Rejected" name="Proposal rejected">
      <bpmn:incoming>F6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:businessRuleTask id="Task_CheckGuide" name="Check guide availability and workload">
      <bpmn:incoming>F_Approved</bpmn:incoming>
      <bpmn:incoming>F_Declined</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:serviceTask id="Task_Allocate" name="Allocate guide">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sendTask id="Task_SendRequest" name="Send allocation request">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:userTask id="Task_GuideReply" name="Accept or decline request">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="GW_Accept" name="Accepted?">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F_Accepted</bpmn:outgoing>
      <bpmn:outgoing>F_Declined</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="Task_NotifyStudent" name="Notify student">
      <bpmn:incoming>F_Accepted</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:serviceTask id="Task_Record" name="Record allocation">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Allocated" name="Project allocated">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Submit" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Validate" targetRef="GW_Valid" />
    <bpmn:sequenceFlow id="F_Valid" name="Yes" sourceRef="GW_Valid" targetRef="Task_Screen" />
    <bpmn:sequenceFlow id="F_Invalid" name="No (resubmit)" sourceRef="GW_Valid" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Screen" targetRef="Task_Evaluate" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Evaluate" targetRef="GW_Decision" />
    <bpmn:sequenceFlow id="F_Approved" name="Approved" sourceRef="GW_Decision" targetRef="Task_CheckGuide" />
    <bpmn:sequenceFlow id="F_Revise" name="Revise" sourceRef="GW_Decision" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="F_Rejected" name="Rejected" sourceRef="GW_Decision" targetRef="Task_NotifyReject" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_NotifyReject" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_CheckGuide" targetRef="Task_Allocate" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Allocate" targetRef="Task_SendRequest" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_SendRequest" targetRef="Task_GuideReply" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_GuideReply" targetRef="GW_Accept" />
    <bpmn:sequenceFlow id="F_Accepted" name="Yes" sourceRef="GW_Accept" targetRef="Task_NotifyStudent" />
    <bpmn:sequenceFlow id="F_Declined" name="No (pick another guide)" sourceRef="GW_Accept" targetRef="Task_CheckGuide" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_NotifyStudent" targetRef="Task_Record" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Record" targetRef="End_Allocated" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="160" y="40" width="2060" height="650" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Student_di" bpmnElement="Lane_Student" isHorizontal="true">
        <dc:Bounds x="190" y="40" width="2030" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Coordinator_di" bpmnElement="Lane_Coordinator" isHorizontal="true">
        <dc:Bounds x="190" y="170" width="2030" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Committee_di" bpmnElement="Lane_Committee" isHorizontal="true">
        <dc:Bounds x="190" y="300" width="2030" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Guide_di" bpmnElement="Lane_Guide" isHorizontal="true">
        <dc:Bounds x="190" y="430" width="2030" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="190" y="560" width="2030" height="130" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="240" y="87" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="218" y="130" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Submit_di" bpmnElement="Task_Submit">
        <dc:Bounds x="320" y="65" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Validate_di" bpmnElement="Task_Validate">
        <dc:Bounds x="470" y="585" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Valid_di" bpmnElement="GW_Valid" isMarkerVisible="true">
        <dc:Bounds x="620" y="600" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="628" y="657" width="34" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Screen_di" bpmnElement="Task_Screen">
        <dc:Bounds x="720" y="195" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Evaluate_di" bpmnElement="Task_Evaluate">
        <dc:Bounds x="870" y="325" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Decision_di" bpmnElement="GW_Decision" isMarkerVisible="true">
        <dc:Bounds x="1020" y="340" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1076" y="397" width="48" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyReject_di" bpmnElement="Task_NotifyReject">
        <dc:Bounds x="995" y="585" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rejected_di" bpmnElement="End_Rejected">
        <dc:Bounds x="1170" y="607" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1148" y="650" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckGuide_di" bpmnElement="Task_CheckGuide">
        <dc:Bounds x="1270" y="585" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Allocate_di" bpmnElement="Task_Allocate">
        <dc:Bounds x="1420" y="585" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendRequest_di" bpmnElement="Task_SendRequest">
        <dc:Bounds x="1570" y="585" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GuideReply_di" bpmnElement="Task_GuideReply">
        <dc:Bounds x="1570" y="455" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Accept_di" bpmnElement="GW_Accept" isMarkerVisible="true">
        <dc:Bounds x="1720" y="470" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1776" y="452" width="56" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyStudent_di" bpmnElement="Task_NotifyStudent">
        <dc:Bounds x="1820" y="585" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Record_di" bpmnElement="Task_Record">
        <dc:Bounds x="1970" y="585" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Allocated_di" bpmnElement="End_Allocated">
        <dc:Bounds x="2120" y="607" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2098" y="650" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="276" y="105" /><di:waypoint x="320" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="370" y="145" /><di:waypoint x="370" y="625" /><di:waypoint x="470" y="625" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="570" y="625" /><di:waypoint x="620" y="625" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Valid_di" bpmnElement="F_Valid">
        <di:waypoint x="670" y="625" /><di:waypoint x="770" y="625" /><di:waypoint x="770" y="275" />
        <bpmndi:BPMNLabel><dc:Bounds x="680" y="607" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Invalid_di" bpmnElement="F_Invalid">
        <di:waypoint x="645" y="600" /><di:waypoint x="645" y="105" /><di:waypoint x="420" y="105" />
        <bpmndi:BPMNLabel><dc:Bounds x="560" y="87" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="820" y="235" /><di:waypoint x="920" y="235" /><di:waypoint x="920" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="970" y="365" /><di:waypoint x="1020" y="365" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Approved_di" bpmnElement="F_Approved">
        <di:waypoint x="1070" y="365" /><di:waypoint x="1320" y="365" /><di:waypoint x="1320" y="585" />
        <bpmndi:BPMNLabel><dc:Bounds x="1100" y="347" width="50" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Revise_di" bpmnElement="F_Revise">
        <di:waypoint x="1045" y="340" /><di:waypoint x="1045" y="52" /><di:waypoint x="370" y="52" /><di:waypoint x="370" y="65" />
        <bpmndi:BPMNLabel><dc:Bounds x="1050" y="300" width="40" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Rejected_di" bpmnElement="F_Rejected">
        <di:waypoint x="1045" y="390" /><di:waypoint x="1045" y="585" />
        <bpmndi:BPMNLabel><dc:Bounds x="1050" y="470" width="50" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6">
        <di:waypoint x="1095" y="625" /><di:waypoint x="1170" y="625" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7">
        <di:waypoint x="1370" y="625" /><di:waypoint x="1420" y="625" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8">
        <di:waypoint x="1520" y="625" /><di:waypoint x="1570" y="625" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9">
        <di:waypoint x="1620" y="585" /><di:waypoint x="1620" y="535" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10">
        <di:waypoint x="1670" y="495" /><di:waypoint x="1720" y="495" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Accepted_di" bpmnElement="F_Accepted">
        <di:waypoint x="1770" y="495" /><di:waypoint x="1870" y="495" /><di:waypoint x="1870" y="585" />
        <bpmndi:BPMNLabel><dc:Bounds x="1780" y="477" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Declined_di" bpmnElement="F_Declined">
        <di:waypoint x="1745" y="520" /><di:waypoint x="1745" y="675" /><di:waypoint x="1320" y="675" /><di:waypoint x="1320" y="665" />
        <bpmndi:BPMNLabel><dc:Bounds x="1500" y="660" width="140" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11">
        <di:waypoint x="1920" y="625" /><di:waypoint x="1970" y="625" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12">
        <di:waypoint x="2070" y="625" /><di:waypoint x="2120" y="625" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>